# MongoDB
MONGODB_URI="mongodb://user:password@host:27017/?authSource=admin&directConnection=true"
# Optional, defaults to "pkd-smm"
MONGODB_DB="pkd-smm"

# Auth
JWT_SECRET="generate-a-long-random-string"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="PKD-SMM Panel <noreply@example.com>"

# Dodo Payments — switch environment: "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Test Mode credentials (used when DODO_PAYMENTS_ENVIRONMENT="test_mode")
DODO_PAYMENTS_TEST_API_KEY=""
DODO_PAYMENTS_TEST_PRODUCT_ID=""

# Live Mode credentials (used when DODO_PAYMENTS_ENVIRONMENT="live_mode")
DODO_PAYMENTS_LIVE_API_KEY=""
DODO_PAYMENTS_PRODUCT_ID=""
